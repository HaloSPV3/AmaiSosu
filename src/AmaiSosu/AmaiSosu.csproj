<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Application | General -->
    <OutputType>Library</OutputType>
    <TargetFrameworks>net462;net480;net6.0-windows</TargetFrameworks>
    <AssemblyName>AmaiSosu.lib</AssemblyName>
    <RootNamespace>AmaiSosu</RootNamespace>
    <ProjectGuid>693BF44B-7BA3-461C-8CE1-D0F11FBE930D</ProjectGuid>
    <!-- Build | General -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <FileAlignment>512</FileAlignment>
    <!-- Build | Error and warnings -->
    <WarningLevel>4</WarningLevel>
    <!-- Build | Output -->
    <!-- Build | Events -->
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>

    <!-- Publish -->
    <IsPublishable>false</IsPublishable>
    <TFM_NET6_OR_LATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))</TFM_NET6_OR_LATER>
    <IsTrimmable>$(TFM_NET6_OR_LATER)</IsTrimmable>
    <IsAotCompatible>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))</IsAotCompatible>
    <VerifyReferenceAotCompatibility>$(IsAotCompatible)</VerifyReferenceAotCompatibility>

    <!-- Misc -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>Embedded</DebugType>
    <!-- If we are publishing a release, do not include symbols; shave a MiB or two -->
    <DebugType Condition="'$(Configuration)' == 'Release' AND '_IsPublishing' == 'true'">none</DebugType>

    <!-- Enable this while you are working on HXE hot-fixes -->
    <UseBleedingEdge_HXE Condition="'$(CI)' != 'true'">false</UseBleedingEdge_HXE>
  </PropertyGroup>

  <PropertyGroup Label="Nuget Properties">
    <_changelogPath>$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)/../../CHANGELOG.md))</_changelogPath>
    <Authors>HaloSPV3</Authors>
    <Company>github/HaloSPV3</Company>
    <Copyright>Copyright © 2021</Copyright>
    <Description>OpenSauce Installer</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconUrl>https://github.com/HaloSPV3/AmaiSosu/blob/main/src/AmaiSosu.GUI/icon.ico</PackageIconUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HaloSPV3/AmaiSosu</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes Condition="Exists($(_changelogPath))">$([System.IO.File]::ReadAllText($(_changelogPath)))</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>Halo</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/HaloSPV3/AmaiSosu</RepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- If we are packing, we MUST include PDBs for the symbols package -->
    <DebugType Condition="'$(_IsPacking)' == 'true'">portable</DebugType>
  </PropertyGroup>

  <ItemGroup Label="NuGet Package Items">
    <None Include="../../media/icons/AmaiSosu.png" Pack="true" PackagePath="/icon.png" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\FileNames.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>FileNames.resx</DependentUpon>
    </Compile>

    <EmbeddedResource Update="Resources\FileNames.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>FileNames.Designer.cs</LastGenOutput>
    </EmbeddedResource>

    <ProjectReference Include="..\..\ext\hxe\src\HXE.csproj" Condition="'$(UseBleedingEdge_HXE)' == 'true'" />
    <PackageReference Include="HXE" Version="2.3.1" Condition="'$(UseBleedingEdge_HXE)' != 'true'" />
    <PackageReference Include="Meziantou.Polyfill" Version="1.0.157"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
      PrivateAssets="All" />
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.1"
      PrivateAssets="All" />
  </ItemGroup>
</Project>
