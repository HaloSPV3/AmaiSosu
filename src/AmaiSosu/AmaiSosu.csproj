<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Application | General -->
    <OutputType>Library</OutputType>
    <TargetFrameworks>net462;net480;net6.0-windows</TargetFrameworks>
    <AssemblyName>AmaiSosu.lib</AssemblyName>
    <RootNamespace>AmaiSosu</RootNamespace>
    <ProjectGuid>693BF44B-7BA3-461C-8CE1-D0F11FBE930D</ProjectGuid>
    <!-- Build | General -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <FileAlignment>512</FileAlignment>
    <!-- Build | Error and warnings -->
    <WarningLevel>4</WarningLevel>
    <!-- Build | Output -->
    <!-- Build | Events -->
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <!-- Publish -->
    <TFM_NET6_OR_LATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))</TFM_NET6_OR_LATER>
    <IsTrimmable>$(TFM_NET6_OR_LATER)</IsTrimmable>
    <!-- Misc -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TrimmingEnabled>$(IsTrimmable)</TrimmingEnabled>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Resources\FileNames.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>FileNames.resx</DependentUpon>
    </Compile>

    <EmbeddedResource Update="Resources\FileNames.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>FileNames.Designer.cs</LastGenOutput>
    </EmbeddedResource>

    <ProjectReference Include="..\..\ext\hxe\src\HXE.csproj" />
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="6.0.9" />
    <PackageReference Include="Meziantou.Polyfill" Version="1.0.157"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
      PrivateAssets="All" />
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.1"
      PrivateAssets="All" />
  </ItemGroup>
</Project>
