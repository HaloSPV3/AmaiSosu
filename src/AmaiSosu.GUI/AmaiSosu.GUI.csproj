<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Application | General -->
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net462;net480;net6.0-windows</TargetFrameworks>
    <AssemblyName>AmaiSosu</AssemblyName>
    <RootNamespace>AmaiSosu.GUI</RootNamespace>
    <!-- Application | Resources -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Build | General -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Deterministic>true</Deterministic>
    <FileAlignment>512</FileAlignment>
    <!-- Build | Error and warnings -->
    <WarningLevel>4</WarningLevel>
    <!-- Build | Output -->
    <!-- Build | Events -->
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <!-- Build | Strong Naming -->
    <SignAssembly>False</SignAssembly>

    <!-- Publish -->
    <TFM_NET6_OR_LATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))</TFM_NET6_OR_LATER>
    <IsTrimmable>$(TFM_NET6_OR_LATER)</IsTrimmable>
    <IsAotCompatible Condition="'$(UseWPF)' != 'true'">$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))</IsAotCompatible>
    <VerifyReferenceAotCompatibility>$(IsAotCompatible)</VerifyReferenceAotCompatibility>
    <PublishAot>$(IsAotCompatible)</PublishAot>
    <!-- Waiting for trim-compatible WPF -->
    <!--<PublishTrimmed>true</PublishTrimmed> -->
    <PublishSingleFile>$(TFM_NET6_OR_LATER)</PublishSingleFile>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(PublishSingleFile)' == 'true'">win7-x86</RuntimeIdentifier>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == 'true' AND $(RuntimeIdentifier.Contains('win7'))">$([MSBuild]::VersionGreaterThanOrEquals($(NETCoreSdkVersion), '6.0.300'))</PublishSingleFile>

    <!-- Manifest Info -->
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <UseApplicationTrust>true</UseApplicationTrust><!-- use ProductName, PublisherName, SupportUrl-->
    <PublisherName>Halo SPV3 Team</PublisherName>
    <SupportUrl>https://github.com/HaloSPV3/AmaiSosu/issues</SupportUrl>
    <TargetZone>Internet</TargetZone>
    <!-- Misc -->
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <ToolCommandName>amaisosu</ToolCommandName>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>Embedded</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <!-- Disable this if we want to require users to install .NET Desktop Runtime 6 or whatever we are targeting at the moment -->
    <SelfContained Condition="'$(SelfContained)' == '' AND '$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>$(SelfContained)</EnableCompressionInSingleFile>
    <StripSymbols Condition="'$(PublishAot)' == 'true' AND '$(Configuration)' == 'Debug'">false</StripSymbols>
  </PropertyGroup>

  <Choose>
    <When Condition="$(TargetFramework.StartsWith('net4'))">
      <PropertyGroup Label="Additional Properties (NET4)">
        <!-- Disabling these two properties prevents the output of (App).exe.config. Yippee! -->
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
        <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
        <WeaverConfiguration>
          <Weavers>
            <Costura />
          </Weavers>
        </WeaverConfiguration>
      </PropertyGroup>
      <ItemGroup Label="Additional References (NET4)">
        <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
      </ItemGroup>
    </When>
  </Choose>

  <PropertyGroup Label="Nuget Properties">
    <_changelogPath>$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)/../../CHANGELOG.md))</_changelogPath>
    <Authors>HaloSPV3</Authors>
    <Company>github/HaloSPV3</Company>
    <Copyright>Copyright © 2021</Copyright>
    <Description>OpenSauce Installer</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconUrl>https://github.com/HaloSPV3/AmaiSosu/blob/main/src/AmaiSosu.GUI/icon.ico</PackageIconUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HaloSPV3/AmaiSosu</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes Condition="Exists($(_changelogPath))">$([System.IO.File]::ReadAllText($(_changelogPath)))</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>Halo</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/HaloSPV3/AmaiSosu</RepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Label="NuGet Package Items">
    <None Include="../../media/icons/AmaiSosu.png" Pack="true" PackagePath="/icon.png" />
    <None Include="../../README.md" Pack="true" PackagePath="/">
      <Link>.docs-misc/readme.md</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmaiSosu\AmaiSosu.csproj" />

    <Resource Include="Resources\Background.png" />
    <Resource Include="icon.ico" />

    <PackageReference Include="MahApps.Metro" Version="3.0.0-rc0529" />
    <PackageReference Include="Meziantou.Polyfill" Version="1.0.157"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
      PrivateAssets="All" />
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.1"
      PrivateAssets="All" />
  </ItemGroup>
</Project>
